{
  "name": "securevault-laboratorio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.js",
    "mongo:stop": "node scripts/stop-local.js",
    "dev": "node --env-file=.env scripts/dev.js",
    "start": "node --env-file=.env src/server.js",
    "admin": "node --env-file-if-exists=.env scripts/admin.js",
    "db:init": "node --env-file=.env scripts/db-init.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "cookie": "^2.0.2",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.9.1"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "^11.4.0"
  }
}
